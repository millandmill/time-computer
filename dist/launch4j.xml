<launch4jConfig>

    <!-- ชื่อ exe ที่ออก -->
    <outfile>TimeComputer.exe</outfile>

    <!-- jar ของคุณ -->
    <jar>time-computer.jar</jar>

    <!-- icon ของ exe -->
    <icon>icon.ico</icon>

    <!-- GUI app (ไม่เปิด console) -->
    <headerType>gui</headerType>

    <!-- โฟลเดอร์ทำงาน -->
    <chdir>.</chdir>

    <!-- main class -->
    <classPath>
        <mainClass>TimeComputer</mainClass>
    </classPath>

    <!-- JRE 8 32-bit -->
    <jre>
        <path>jre</path>
        <minVersion>1.8.0</minVersion>
        <bundledJre64Bit>false</bundledJre64Bit>
    </jre>

</launch4jConfig>